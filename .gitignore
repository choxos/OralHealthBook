# macOS
.DS_Store
._*

# Quarto
/.quarto/
/_book/
/_site/
*.rmarkdown

# LaTeX intermediates
*.aux
*.log
*.toc
*.lof
*.lot
*.out
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg

# Print artifacts are built locally, not versioned
/dist/

# R
.Rproj.user/
.Rhistory
.RData
.Renviron

# Python
__pycache__/
*.pyc
.venv/

# Saved-page scaffolding from the archived guideline and blog HTML.
# The .html files and the figure images inside *_files/ are kept;
# the bundled scripts and stylesheets are not.
sources/**/*.js
sources/**/*.css
sources/**/*.woff
sources/**/*.woff2

**/*.quarto_ipynb

# Third-party material kept locally but never redistributed.
#
# SIGN 138 is Healthcare Improvement Scotland copyright. The book quotes it for
# criticism and review under CDPA s30; republishing the whole PDF is not covered.
sources/Books/SIGN_Scot/*.pdf
#
# The saved Medium pages embed figures taken from journal articles. The book
# redraws every figure from the underlying numbers precisely so that it never
# reproduces one, and the repo should hold to the same rule.
sources/BlogPosts/**/*.png
sources/BlogPosts/**/*.jpg
sources/BlogPosts/**/*.jpeg
sources/BlogPosts/**/*.gif
sources/BlogPosts/**/*.webp
sources/BlogPosts/**/*_files/

# Working library of source PDFs and Cochrane full texts, supplied for writing
# the audits. Third-party copyrighted material: read locally, never published.
# Every claim drawn from it is quoted with its source in the text.
documentation/
